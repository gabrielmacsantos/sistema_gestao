# "Continuar com o Google" (opcional; sem isto, só e-mail e senha). Crie um "ID do cliente OAuth"
# do tipo "Aplicativo da Web" no Google Cloud, com o URI de redirecionamento
# <APP_URL>/api/auth/google/callback. O segredo fica só no servidor.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Endereço pelo qual você abre o app. O Google só aceita localhost ou https.
APP_URL="http://localhost:3000"
